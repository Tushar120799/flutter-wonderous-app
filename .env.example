# Unsplash API credentials
# Used only by developer tools (UnsplashDownloadService); not required for production builds.
# Copy this file to .env and fill in your keys, or pass these as --dart-define flags at build time.
#
# Example (flutter run):
#   flutter run --dart-define=UNSPLASH_ACCESS_KEY=your_access_key --dart-define=UNSPLASH_SECRET_KEY=your_secret_key
#
# Obtain keys at: https://unsplash.com/developers

UNSPLASH_ACCESS_KEY=your_access_key_here
UNSPLASH_SECRET_KEY=your_secret_key_here
